@{
    var title = ViewData["Title"] as string ?? "EchoCrafter gaming";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - EchoCrafter gaming</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/modern-normalize@2/modern-normalize.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="container header">
    <a class="brand" href="/">EchoCrafter gaming</a>
    <nav>
        <a href="/">Home</a>
        <a href="/cart">Cart</a>
    </nav>
</header>
<main class="container">
    @RenderBody()
</main>
<footer class="container footer">
    <p>&copy; @DateTime.UtcNow.Year - EchoCrafter gaming</p>
</footer>
<script src="~/js/site.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
