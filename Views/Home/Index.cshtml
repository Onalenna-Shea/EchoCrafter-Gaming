@model IEnumerable<EchoCrafter.Models.Product>
@{
    ViewData["Title"] = "Home";
    var categories = ViewBag.Categories as IEnumerable<EchoCrafter.Models.Category>;
    string active = ViewBag.ActiveCategory as string ?? "";
}
<section class="hero">
    <img src="/img/EchoCrafter logo.jpeg" width="150" height="150" style="border-radius:50%;"/>
    <h1>Shop with us at EchoCrafter gaming</h1>
    <p>Bloemfontein 9300, Mangaung, Rockland 3999 Choeu Str</p>
</section>

<div class="filters">
    <a class="chip @(string.IsNullOrEmpty(active) ? "active" : "")" href="/">All</a>
    @if (categories != null) {
        foreach (var c in categories) {
            <a class="chip @(active == c.Slug ? "active" : "")" href="/?category=@c.Slug">@c.Name</a>
        }
    }
</div>

<div class="grid">
@foreach (var p in Model) {
    <article class="card">
        <a href="/products/@p.Slug">
            <img src="@p.ImageUrl" alt="@p.Name" />
            <div class="card-body">
                <h3>@p.Name</h3>
                <p class="price">R @p.Price</p>
            </div>
        </a>
        <form method="post" action="/cart/add/@p.Id">
            <button class="btn">Add to cart</button>
        </form>
    </article>
}
</div>
